#!/bin/bash
# Sweeps TILE_SIZE over powers of 2 (8..1024), rebuilding with -DTILE_SIZE=<N> and
# running the full image-size benchmark for each into its own log file.
# No source file is modified.

set -u

# ---------------------------------------------------------------- configuration
OUTPUT_DIR="./logs_final_tile"

PERF_EVENTS="cpu_core/L1-dcache-load-misses/,cpu_core/cpu-cycles/,cpu_core/instructions/,context-switches"

KERNEL_SIZE=3
SEED=1234
REPETITIONS=20
START_SIZE=64
END_SIZE=16384

TILE_START=8
TILE_END=1024

# ------------------------------------------------------------------- safeguards
if [[ ! -f Makefile ]]; then
    echo "error: no Makefile here. Run this script from the project root." >&2
    exit 1
fi

# The EXTRA_CXXFLAGS hook must exist, or every build would silently use the default
# tile size and the whole sweep would produce eight identical logs.
if ! grep -q 'EXTRA_CXXFLAGS' Makefile; then
    echo "error: Makefile has no EXTRA_CXXFLAGS hook; see the patched Makefile." >&2
    exit 1
fi

mkdir -p "$OUTPUT_DIR"

# Ask for the sudo credential once up front so the loop is not interrupted later.
sudo -v || exit 1

# ------------------------------------------------------------------- the sweep
for ((tile = TILE_START; tile <= TILE_END; tile *= 2)); do

    FULL_LOG_PATH="$OUTPUT_DIR/tile_${tile}_speedup.txt"
    echo "=== TILE_SIZE=$tile -> $FULL_LOG_PATH ==="

    # A full rebuild is mandatory: EXTRA_CXXFLAGS changes no prerequisite timestamp,
    # so without `make clean` make would keep the previous tile size's binary.
    BUILD_LOG="$(mktemp)"
    if ! { make clean && make all EXTRA_CXXFLAGS="-DTILE_SIZE=${tile}"; } \
         > "$BUILD_LOG" 2>&1; then
        echo "error: build failed for TILE_SIZE=$tile" >&2
        cat "$BUILD_LOG" >&2
        rm -f "$BUILD_LOG"
        exit 1
    fi

    # Confirm the define actually reached the compiler before spending an hour on it.
    if ! grep -q -- "-DTILE_SIZE=${tile}" "$BUILD_LOG"; then
        echo "error: -DTILE_SIZE=$tile did not reach the compile line" >&2
        cat "$BUILD_LOG" >&2
        rm -f "$BUILD_LOG"
        exit 1
    fi

    {
        echo "############################################################"
        echo "# TILE_SIZE = $tile"
        echo "# started   : $(date -Is)"
        echo "############################################################"
        cat "$BUILD_LOG"
        echo "Compilation done"

        for ((size = START_SIZE; size <= END_SIZE; size *= 2)); do
            echo "Starting with $size"

            for ((rep = 1; rep <= REPETITIONS; rep++)); do
                sudo perf stat -e "$PERF_EVENTS" \
                    taskset -c 0 bin/conv tile "$size" "$size" "$KERNEL_SIZE" "$SEED"
            done

            echo "Done with $size"
        done

        echo "# finished  : $(date -Is)"
    } > "$FULL_LOG_PATH" 2>&1

    rm -f "$BUILD_LOG"
    echo "Done with TILE_SIZE=$tile"
done

# Leave the tree in the state a plain `make` would produce, not the last sweep point.
make clean > /dev/null 2>&1
make all   > /dev/null 2>&1

echo "Sweep complete. Logs in $OUTPUT_DIR/"