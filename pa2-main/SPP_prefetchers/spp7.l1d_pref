#include "cache.h"
#define MASK_IP 0xFF
#define PREFETCH_DEGREE 8
// length of history to be stored
#define MAX_K 8
// Number patterns to be stored at a time per IP
#define N 24

// Number of Ips to be stored at a time
#define IP_TRACKER_COUNT 64

class TableEntry{
    public:
        int64_t last_strides[MAX_K];
        int64_t pred_stride;
        uint64_t valid;
        uint64_t lru;
        int64_t confidence;
        int64_t err;
        TableEntry(){
            for(int i = 0; i < MAX_K; ++i){
                last_strides[i] = 0;
            }
            pred_stride = 0;
            valid = 0;
            lru = 0;
            confidence = 0;
            err = 0;
        }
};
void cleanTableEntry(TableEntry &a){
    // takes a table entry and cleans it
    for(int i = 0; i < MAX_K; ++i){
        a.last_strides[i] = 0;
    }
    a.pred_stride = 0;
    a.valid = 0;
    a.lru = 0;
    a.confidence = 0;
    a.err = 0;
    return;
}
class Table{
    public:
        TableEntry Enteries[N];

        Table(){
            for(int i = 0; i < N; ++i){
                Enteries[i] = TableEntry();
            }
        }
};
void cleanTable(Table &a){
    // takes a table and cleans it up
    for(int i = 0; i < N; ++i){
        cleanTableEntry(a.Enteries[i]);
    }
    for(int i = 0; i < N; ++i){
        a.Enteries[i].lru = i;
    
    }
    return;
}
class SPP_TRACKER{
    public:
        uint64_t ip;
        uint64_t K;
        uint64_t last_cl_addr;
        int64_t lastKstrides[MAX_K];
        uint32_t lru;
        int64_t off_ctr;
        uint64_t off_flag;
        Table patTable;

        SPP_TRACKER(){
            ip = 0;
            last_cl_addr = 0;
            for(int i = 0; i < MAX_K; ++i){
                lastKstrides[i] = 0;
            }
            lru = 0;
            off_ctr = 0;
            K = 1;
            off_flag = 0;
            patTable = Table();
        }
};

SPP_TRACKER trackers[IP_TRACKER_COUNT];

TableEntry* matchHistory(SPP_TRACKER &tracker, int64_t strides[MAX_K], uint64_t K){

    // Returns pointer to table entry if match found else return null
    for(int i = 0; i < N; ++i){
        TableEntry* entry = &(tracker.patTable.Enteries[i]);
        if(entry->valid == 0) continue;
        uint32_t match = 1;
        for(int j = MAX_K - K; j < MAX_K; ++j){
            if(entry->last_strides[j] != strides[j]){
                match = 0;
                break;
            }
        }
        if(match){
            return entry;
        }
    }
    return nullptr;
}

void CACHE::l1d_prefetcher_initialize() 
{
    std::cout << "------------------------------------------------" << std::endl;
    std::cout << "        Stride Pattern Prefetcher (SPP)         " << std::endl;
    std::cout << "------------------------------------------------" << std::endl;
    for(int i = 0; i < IP_TRACKER_COUNT; ++i){
        trackers[i].lru = i;
        trackers[i].ip = 0;
        cleanTable(trackers[i].patTable);
    }
}

void AllocatePatternMRU(Table &table, int64_t *strides, int64_t pred_stride){
    // Allocate a new entry in the pattern table
    // and set it to the given strides and pred_stride
    // find the LRU entry
    int lru_index = -1;
    for(int i = 0; i < N; ++i){
        if(table.Enteries[i].lru == (N-1)){
            lru_index = i;
            break;
        }
    }
    if(lru_index == -1){
        std::cerr << "Error: No LRU entry found in pattern table" << std::endl;
        return;
    }
    TableEntry &entry = table.Enteries[lru_index];
    for(int i = 0; i < MAX_K; ++i){
        entry.last_strides[i] = strides[i];
    }
    entry.pred_stride = pred_stride;
    entry.valid = 1;
    entry.confidence = 1;
    entry.err = 0;
    // Update LRU of all entries
    for(int i = 0; i < N; ++i){
        if(i != lru_index && table.Enteries[i].lru < entry.lru){
            table.Enteries[i].lru++;
        }
    }
    entry.lru = 0;

    return;
}
void ShiftStride(int64_t *strides, int64_t pred_stride, int64_t *new_strides){
    // Shift the strides to the left and add new_stride at the end
    for(int i = 0; i < MAX_K-1; ++i){
        new_strides[i] = strides[i+1];
    }
    new_strides[MAX_K-1] = pred_stride;
    return;
}
void CACHE::l1d_prefetcher_operate(uint64_t addr, uint64_t ip, uint8_t cache_hit, uint8_t type, uint8_t critical_ip_flag)
{
   uint64_t cl_addr = addr >> LOG2_BLOCK_SIZE;

   ip = ip & MASK_IP;

   int index = -1;
   for(index = 0; index < IP_TRACKER_COUNT; ++index){
        if(trackers[index].ip == ip){
            break;
        }
   }

   // No such IP in the table, allocate
   // an entry, deallocate the LRU entry
   // Update recency

   if(index == IP_TRACKER_COUNT){
        for(index = 0; index < IP_TRACKER_COUNT; ++index){
            if(trackers[index].lru == (IP_TRACKER_COUNT -1))
                break;
        }
        trackers[index].ip = ip;
        trackers[index].last_cl_addr = cl_addr;
        trackers[index].K = 1;
        trackers[index].off_flag = 0;  
        trackers[index].off_ctr = 0;
        cleanTable(trackers[index].patTable);
        for(int i = 0; i < MAX_K; ++i){
            trackers[index].lastKstrides[i] = 0;
        }
        for (int i=0; i<IP_TRACKER_COUNT; i++) {
            if (trackers[i].lru < trackers[index].lru)
                trackers[i].lru++;
        }
        trackers[index].lru = 0;
        return;
   }
    int64_t stride = 0;
    if (cl_addr > trackers[index].last_cl_addr)
        stride = cl_addr - trackers[index].last_cl_addr;
    else {
        stride = trackers[index].last_cl_addr - cl_addr;
        stride *= -1;
    }

    if(stride == 0){
        return;
    }
    // train the prefetcher with the new stride
    TableEntry* entry_curr = matchHistory(trackers[index], trackers[index].lastKstrides, trackers[index].K);
    if(entry_curr == nullptr){
        AllocatePatternMRU(trackers[index].patTable, trackers[index].lastKstrides, stride);
    }
    else{
        if(entry_curr->pred_stride == stride){
            if(entry_curr->confidence < 3) entry_curr->confidence++;
            if(entry_curr->err > 0) entry_curr->err--;
            if(trackers[index].off_ctr > 0) trackers[index].off_ctr--;
        }
        else{
            if(entry_curr->confidence > 0){ 
                entry_curr->confidence--;
            }
            else{
                entry_curr->pred_stride = stride;
                entry_curr->confidence = 1;
            }

            entry_curr->err += 8;
            if(entry_curr->err > 15) entry_curr->err = 15;
            if(trackers[index].off_ctr < 3) trackers[index].off_ctr++;
            if(trackers[index].K < MAX_K && entry_curr->err >= 15){
                trackers[index].K++;
                cleanTable(trackers[index].patTable);
                trackers[index].off_ctr = 0;
                entry_curr = nullptr;   
            }
            else if(trackers[index].K == MAX_K && trackers[index].off_ctr >= 3){
                trackers[index].off_flag = 1;
            }
        }
        
        if(entry_curr != nullptr){   
            uint64_t this_lru = entry_curr->lru;
            for(int i = 0; i < N; ++i){
                if(trackers[index].patTable.Enteries[i].lru < this_lru){
                    trackers[index].patTable.Enteries[i].lru++;
                }
            }
            entry_curr->lru = 0;
        }
    }
    int64_t pattern[MAX_K];
    
    ShiftStride(trackers[index].lastKstrides, stride, pattern);
    uint64_t tmp_cl_addr = cl_addr;
    for(int p = 0; p < PREFETCH_DEGREE && trackers[index].off_flag == 0; ++p){   
        TableEntry* entry = matchHistory(trackers[index], pattern, trackers[index].K);
        if(entry == nullptr){
            break;
        }
        uint64_t pf_address = (tmp_cl_addr + (entry->pred_stride)) << LOG2_BLOCK_SIZE;
        tmp_cl_addr = pf_address >> LOG2_BLOCK_SIZE;
        if ((pf_address >> LOG2_PAGE_SIZE) != (addr >> LOG2_PAGE_SIZE))
            break;
        if (MSHR.occupancy < (MSHR.SIZE>>1))
            prefetch_line(ip, addr, pf_address, FILL_L1, 0);
        else
            prefetch_line(ip, addr, pf_address, FILL_L2, 0);
        // Shift the pattern to the left and add the new stride
        ShiftStride(pattern, entry->pred_stride, pattern);
    }



    // for(int i = 0; i < K -1; ++i){
    //     trackers[index].lastKstrides[i] = trackers[index].lastKstrides[i+1];
    // }
    // trackers[index].lastKstrides[K-1] = stride;
    ShiftStride(trackers[index].lastKstrides, stride, trackers[index].lastKstrides);
    trackers[index].last_cl_addr = cl_addr;
    for (int i=0; i<IP_TRACKER_COUNT; i++) {
        if (trackers[i].lru < trackers[index].lru)
            trackers[i].lru++;
    }
    trackers[index].lru = 0;
    return;
}

