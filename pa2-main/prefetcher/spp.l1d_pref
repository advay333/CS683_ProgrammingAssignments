#include "cache.h"
#define MASK_IP 0xFF

// length of history to be stored
#define K 3
// Number patterns to be stored at a time per IP
#define N 24

// Number of Ips to be stored at a time
#define IP_TRACKER_COUNT 24

class TableEntry{
    public:
        int64_t last_strides[K];
        int64_t pred_stride;
        uint64_t valid;
        uint64_t lru;
        TableEntry(){
            for(int i = 0; i < K; ++i){
                last_strides[i] = 0;
            }
            pred_stride = 0;
            valid = 0;
            lru = 0;
        }
};
void cleanTableEntry(TableEntry &a){
    // takes a table entry and cleans it
    for(int i = 0; i < K; ++i){
        a.last_strides[i] = 0;
    }
    a.pred_stride = 0;
    a.valid = 0;
    a.lru = 0;
    return;
}
class Table{
    public:
        TableEntry Enteries[N];

        Table(){
            for(int i = 0; i < N; ++i){
                Enteries[i] = TableEntry();
            }
        }
};
void cleanTable(Table &a){
    // takes a table and cleans it up
    for(int i = 0; i < N; ++i){
        cleanTableEntry(a.Enteries[i]);
    }
    for(int i = 0; i < N; ++i){
        a.Enteries[i].lru = i;
    
    }
    return;
}
class SPP_TRACKER{
    public:
        uint64_t ip;

        uint64_t last_cl_addr;
        int64_t lastKstrides[K];
        uint32_t lru;

        Table patTable;

        SPP_TRACKER(){
            ip = 0;
            last_cl_addr = 0;
            for(int i = 0; i < K; ++i){
                lastKstrides[i] = 0;
            }
            lru = 0;
            patTable = Table();
        }
};

SPP_TRACKER trackers[IP_TRACKER_COUNT];

void CACHE::l1d_prefetcher_initialize() 
{
    std::cout << "------------------------------------------------" << std::endl;
    std::cout << "        Stride Pattern Prefetcher (SPP)         " << std::endl;
    std::cout << "------------------------------------------------" << std::endl;
    for(int i = 0; i < IP_TRACKER_COUNT; ++i){
        trackers[i].lru = i;
        trackers[i].ip = 0;
        cleanTable(trackers[i].patTable);
    }
}

void CACHE::l1d_prefetcher_operate(uint64_t addr, uint64_t ip, uint8_t cache_hit, uint8_t type, uint8_t critical_ip_flag)
{
   uint64_t cl_addr = addr >> LOG2_BLOCK_SIZE;

   ip = ip & MASK_IP;

   int index = -1;
   for(index = 0; index < IP_TRACKER_COUNT; ++index){
        if(trackers[index].ip == ip){
            break;
        }
   }

   // No such IP in the table, allocate
   // an entry, deallocate the LRU entry
   // Update recency

   if(index == IP_TRACKER_COUNT){
        for(index = 0; index < IP_TRACKER_COUNT; ++index){
            if(trackers[index].lru == (IP_TRACKER_COUNT -1))
                break;
        }
        trackers[index].ip = ip;
        trackers[index].last_cl_addr = cl_addr;
        cleanTable(trackers[index].patTable);
        for(int i = 0; i < K; ++i){
            trackers[index].lastKstrides[i] = 0;
        }
        for (int i=0; i<IP_TRACKER_COUNT; i++) {
            if (trackers[i].lru < trackers[index].lru)
                trackers[i].lru++;
        }
        trackers[index].lru = 0;
        return;
   }
    int64_t stride = 0;
    if (cl_addr > trackers[index].last_cl_addr)
        stride = cl_addr - trackers[index].last_cl_addr;
    else {
        stride = trackers[index].last_cl_addr - cl_addr;
        stride *= -1;
    }

    if(stride == 0){
        return;
    }

    // Decide whether to prefetch
    // Scan the pattern table and look for 
    // this current pattern, if exists then prefetch
    // else nothing
    // what are we looking for
    // trackers[index].patTable.Enteries[i].last_strides[0..K] = 
    // trackers[index].lastKstrides[1..K] concat stride
    // if yes then prefetch the pred stride else No
    int y = 0;
    for(y = 0; y < N; ++y){
        TableEntry* entry = &(trackers[index].patTable.Enteries[y]);
        if(entry->valid == 0) continue;

        uint32_t match = 1;
        for(int i = 0; i < K-1; ++i){
            if(entry->last_strides[i] != trackers[index].lastKstrides[i+1]){
                match = 0;
                break;
            }
        }
        if(stride != entry->last_strides[K-1]){
            match = 0;
        }
        if(match == 0){
            continue;
        }

        // This is a match start prefetching
        uint64_t pf_address = (cl_addr + (entry->pred_stride)) << LOG2_BLOCK_SIZE;
        if ((pf_address >> LOG2_PAGE_SIZE) != (addr >> LOG2_PAGE_SIZE))
            break;
        if (MSHR.occupancy < (MSHR.SIZE>>1))
            prefetch_line(ip, addr, pf_address, FILL_L1, 0);
        else
            prefetch_line(ip, addr, pf_address, FILL_L2, 0);

        break;
    }
    if(y != N){
        // table entry was matched we need to
        //update the LRU of this table entry
        uint64_t this_lru = trackers[index].patTable.Enteries[y].lru;
        for(int i = 0; i < N; ++i){
            if(trackers[index].patTable.Enteries[i].lru < this_lru){
                trackers[index].patTable.Enteries[i].lru ++;
            }
        }
        trackers[index].patTable.Enteries[y].lru = 0;
    }

    // if y == N this entry was not found and
    // nothing should be doesn

    //Now the work is to update the pattern table
    // we need to search for 
    // trackers[index].last_strides[0..K]
    // if present update pred to stride
    // if not present allocate entry with pred stride

    uint64_t x = 0;
    for(x = 0; x < N; ++x){
        TableEntry* entry = &(trackers[index].patTable.Enteries[x]);
        if(entry->valid == 0) continue;
        uint32_t match = 1;
        for(int i = 0; i < K; ++i){
            if(entry->last_strides[i] != trackers[index].lastKstrides[i]){
                match = 0;
                break;
            }
        }
        if(match == 0) continue;
        break;
    }
    if(x == N){
        //allocate lru entry
        for(x = 0; x < N; ++x){
            if(trackers[index].patTable.Enteries[x].lru == (N-1)) break;
        }
    }
    for(int i = 0; i < K ; ++i){
        trackers[index].patTable.Enteries[x].last_strides[i] = trackers[index].lastKstrides[i];
    }
    trackers[index].patTable.Enteries[x].pred_stride = stride;
    trackers[index].patTable.Enteries[x].valid = 1;
    //update lru of this entry
    for(int i = 0; i < N; ++i){
        if(trackers[index].patTable.Enteries[i].lru < trackers[index].patTable.Enteries[x].lru){
            trackers[index].patTable.Enteries[i].lru ++;
        }
    }
    trackers[index].patTable.Enteries[x].lru = 0;
    trackers[index].last_cl_addr = cl_addr;
    for(int i = 0; i < K -1; ++i){
        trackers[index].lastKstrides[i] = trackers[index].lastKstrides[i+1];
    }
    trackers[index].lastKstrides[K-1] = stride;

    for (int i=0; i<IP_TRACKER_COUNT; i++) {
        if (trackers[i].lru < trackers[index].lru)
            trackers[i].lru++;
    }
    trackers[index].lru = 0;
    return;
}

void CACHE::l1d_prefetcher_cache_fill(uint64_t v_addr, uint64_t addr, uint32_t set, uint32_t way, uint8_t prefetch, uint64_t v_evicted_addr, uint64_t evicted_addr, uint32_t metadata_in)
{
	return; //metadata_in;
}

void CACHE::l1d_prefetcher_final_stats()
{
    return;
}